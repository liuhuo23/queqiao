[Unit]
Description=鹊桥 Agent (reverse tunnel client)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 首次运行请手动执行：queqiao -s <服务端地址>:39999
# 实际安装推荐：queqiao install-service（会自动生成此 unit）
ExecStart=/usr/local/bin/queqiao run
Restart=always
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
