[Unit]
Description=鹊桥 server (no-config reverse tunnel)
Documentation=https://github.com/yourname/queqiao
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/queqiaod -config /etc/queqiao/queqiaod.json
Restart=always
RestartSec=3
LimitNOFILE=65536
# 可选加固（按需打开）：
# NoNewPrivileges=true
# PrivateTmp=true
# ProtectSystem=full
# ReadWritePaths=/var/lib/queqiao

[Install]
WantedBy=multi-user.target
